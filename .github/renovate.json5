// Renovate proposes the version updates of this repository. Dependabot keeps
// its alerts and its security updates; its version updates are off, so that
// two bots do not open the same pull request.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],

  timezone: "Europe/Istanbul",
  // Once a week, before the working day.
  schedule: ["before 6am on monday"],

  // A release is taken a week after it is published: one that turns out to
  // be broken or malicious is usually withdrawn within days.
  minimumReleaseAge: "7 days",

  rebaseWhen: "conflicted",
  prConcurrentLimit: 2,
  prHourlyLimit: 2,
  dependencyDashboard: true,
  vulnerabilityAlerts: { enabled: false },

  enabledManagers: ["github-actions", "gradle", "gradle-wrapper", "npm"],

  packageRules: [
    { matchManagers: ["github-actions"], groupName: "GitHub Actions" },
    { matchManagers: ["gradle", "gradle-wrapper"], groupName: "Gradle plugins and libraries" },
    { matchManagers: ["npm"], groupName: "VS Code extension" },

    // The type definitions must not be newer than the Node.js runtime the
    // extension runs on: the VS Code versions it supports and the Node.js
    // version CI uses. A major update is made by hand together with those.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["@types/node"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },

    // The type definitions of the VS Code API must be those of the oldest
    // VS Code the extension says it supports, `engines.vscode` in its
    // package.json. Newer ones let the code use an API that version does
    // not have, and the packaging tool refuses the mismatch. They are raised
    // by hand, together with `engines.vscode`.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["@types/vscode"],
      enabled: false,
    },
  ],
}
